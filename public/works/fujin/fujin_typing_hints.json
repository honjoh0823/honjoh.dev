{
  "metadata": {
    "layout": "Fujin (風神配列) - lu1",
    "description": "Typing hints for Japanese phoneme input using the Fujin left-hand layout",
    "notation": {
      "keyFormat": "output[physicalKey] — e.g. k[A] means physical key A outputs 'k'",
      "arrowMeaning": "Hold previous key(s), then press the next key",
      "primary": "Recommended (most efficient) input method",
      "supplementary": "Alternative valid input — listed as 'alt' with a 'note'"
    },
    "vowelRules": {
      "isVowelRow": "Physical keys A,S,D,F output vowels (A=e, S=i, D=o, F=a) when ANY other character key is held",
      "spaceReverse": "Pressing Space while holding a consonant outputs that consonant key's assigned vowel",
      "lalt": "LAlt outputs 'u' when any character key or CapsLock is held",
      "spaceHoldVowel": "Space(hold)+C outputs 'u' (spaceVowel override)"
    },
    "spaceReverseVowelMap": {
      "A": "e",
      "S": "i",
      "D": "o",
      "F": "a",
      "G": "a",
      "Q": "e",
