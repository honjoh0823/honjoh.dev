---
interface Props {
    title: string;
    description?: string;
    class?: string;
}

const {
    title,
    description = "Honjoh Nobuhiro - Global Automation Platform",
    class: extraClass = "",
} = Astro.props;

import Layout from "./Layout.astro";
---

<Layout title={title} description={description}>
    <main class={`page ${extraClass}`}>
        <slot name="header" />
        <slot />
        <slot name="footer" />
    </main>
</Layout>
