---
import HintBar from "./HintBar.astro";

interface Props {
    class?: string;
}

const { class: extraClass = "" } = Astro.props;
---

<footer class={`site-footer ${extraClass}`.trim()}>
    <div class="site-footer-separator" aria-hidden="true"></div>
    <slot name="prompt" />
    <HintBar>
        <slot />
    </HintBar>
</footer>

<style>
    .site-footer {
        position: relative;
        z-index: 1;
        margin-top: 0.65rem;
    }

    .site-footer-separator {
        width: 100%;
        height: 1px;
        background: color-mix(in srgb, var(--border) 55%, transparent);
        margin-bottom: 0.6rem;
    }

    .site-footer :global(.prompt-area) {
        margin-top: 0;
        border-top: none;
        padding-top: 0;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid color-mix(in srgb, var(--border) 45%, transparent);
    }

    .site-footer :global(.prompt-input::placeholder) {
        opacity: 0.45;
    }

    @media (max-width: 640px) {
        .site-footer {
            margin-top: 0.5rem;
        }
    }
</style>
