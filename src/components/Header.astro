---
interface Props {
    path: string[];
}

const { path } = Astro.props;
const breadcrumb = path.join(" > ");
const isTopPage = path.length === 0;
---

<header class="page-header">
    <div class="header-top">
        <a href="/" class="site-name">honjoh.dev</a>
        <span class="tagline">Honjoh Nobuhiro</span>
    </div>
    <div class="bc-line">
        {isTopPage ? "Nobuhiro Honjoh" : `> ${breadcrumb}`}
    </div>
</header>

<style>
    .page-header {
        position: relative;
        z-index: 1;
    }

    .header-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 1rem;
    }

    .site-name {
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: 0.12em;
        color: var(--fg-bright);
        text-decoration: none;
        border-bottom: none;
    }

    .site-name:hover {
        color: var(--accent);
        border-bottom: none;
    }

    .tagline {
        color: var(--dim);
        font-size: 0.8rem;
        font-weight: 300;
    }

    .bc-line {
        font-size: 0.8rem;
        color: var(--dim);
        margin-bottom: 2rem;
    }
</style>
