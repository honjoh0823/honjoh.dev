---
import TerminalLayout from "../../layouts/TerminalLayout.astro";
import Header from "../../components/Header.astro";
import HintBar from "../../components/HintBar.astro";
---

<TerminalLayout
    title="Chat - honjoh.dev"
    description="Talk to Honjoh's AI representative"
    class="chat-page"
>
    <Header slot="header" path={["chat"]} />

    <!-- Chat log -->
    <div class="chat-log" id="chat-log"></div>

    <!-- Input -->
    <div class="chat-input-area" slot="footer">
        <div class="prompt-area">
            <span class="prompt-symbol">❯</span>
            <input
                type="text"
                id="chat-input"
                class="prompt-input"
                placeholder="ask anything..."
                autocomplete="off"
                autofocus
            />
            <div class="cmd-palette" id="cmd-palette" style="display:none">
                <!-- populated by JS -->
            </div>
        </div>
        <HintBar>
            <span><kbd>Enter</kbd> send</span>
            <span><kbd>/</kbd> command</span>
            <span><kbd>←</kbd> back</span>
        </HintBar>
    </div>
</TerminalLayout>

<style>
    /* Chat page: full height, scrollable log */
    :global(.chat-page) {
        height: 100vh;
        min-height: unset;
    }

    .chat-log {
        flex: 1;
        overflow-y: auto;
        max-width: var(--max-width);
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .chat-log::-webkit-scrollbar {
        width: 4px;
    }
    .chat-log::-webkit-scrollbar-track {
        background: transparent;
    }
    .chat-log::-webkit-scrollbar-thumb {
        background: var(--border-strong);
        border-radius: 2px;
    }

    /* Welcome */
    :global(.chat-welcome) {
        color: var(--dim);
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
        line-height: 1.7;
    }

    :global(.chat-welcome .accent) {
        color: var(--accent);
    }

    /* Messages — A3 style: color contrast only */
    :global(.chat-entry) {
        line-height: 1.7;
        font-size: 0.85rem;
        margin-bottom: 0.8rem;
    }

    :global(.chat-entry-user) {
        color: var(--fg);
    }

    :global(.chat-entry-ai) {
        color: var(--dim);
    }

    :global(.chat-entry-system) {
        color: var(--dim);
        font-size: 0.8rem;
    }

    /* Typing indicator - V2: non-verbal visual dots */
    :global(.typing-indicator) {
        display: inline-flex;
        gap: 5px;
        align-items: center;
    }

    :global(.typing-indicator .dot) {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--accent);
        animation: dotPulse 1.4s ease-in-out infinite;
    }

    :global(.typing-indicator .dot:nth-child(1)) {
        animation-delay: 0s;
    }

    :global(.typing-indicator .dot:nth-child(2)) {
        animation-delay: 0.2s;
    }

    :global(.typing-indicator .dot:nth-child(3)) {
        animation-delay: 0.4s;
    }

    @keyframes dotPulse {
        0%,
        100% {
            opacity: 0.3;
        }
        50% {
            opacity: 1;
        }
    }

    /* Input area */
    .chat-input-area {
        position: relative;
        z-index: 1;
    }

    /* Command palette */
    .cmd-palette {
        position: absolute;
        bottom: calc(100% + 8px);
        left: 0;
        right: 0;
        max-width: var(--max-width);
        border: 1px solid var(--border);
        background: var(--bg);
        z-index: 10;
    }

    :global(.cmd-header) {
        padding: 0.5rem 1rem;
        font-size: 0.75rem;
        color: var(--dim);
        letter-spacing: 0.08em;
    }

    :global(.cmd-item) {
        display: flex;
        align-items: center;
        gap: 1.5ch;
        padding: 0.5rem 1rem;
        cursor: pointer;
        font-size: 0.85rem;
        transition: background 0.1s;
    }

    :global(.cmd-item:hover),
    :global(.cmd-item.cmd-active) {
        background: var(--accent-dim);
    }

    :global(.cmd-name) {
        color: var(--fg);
        font-weight: 500;
    }

    :global(.cmd-match) {
        color: var(--accent);
        font-weight: 700;
    }

    :global(.cmd-desc) {
        color: var(--dim);
        font-size: 0.8rem;
        margin-left: auto;
    }

    /* Responsive */
    @media (max-width: 640px) {
        .chat-log {
            padding: 0;
        }
    }
</style>

<script>
    import { getLang, t, chat, common } from "../../lib/i18n";

    // --- API config ---
    const isDev =
        window.location.hostname === "localhost" ||
        window.location.hostname === "127.0.0.1";
    const BASE_URL = isDev ? "http://localhost:3002" : "https://api.honjoh.dev";

    let sessionId: string | null = localStorage.getItem("chat-session-id");

    // --- Conversation history (for /send) ---
    const STORAGE_KEY = "chat-history";
    const conversationHistory: { role: "user" | "ai"; text: string }[] = [];

    function saveHistory() {
        try {
            localStorage.setItem(
                STORAGE_KEY,
                JSON.stringify(conversationHistory),
            );
        } catch (_) {
            /* quota exceeded — silently ignore */
        }
    }

    function loadHistory(): { role: "user" | "ai"; text: string }[] {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : [];
        } catch (_) {
            return [];
        }
    }

    function clearHistory() {
        conversationHistory.length = 0;
        localStorage.removeItem(STORAGE_KEY);
    }

    function getMockResponse(): string {
        return t(chat, "chat.error");
    }

    async function callChatAPI(
        message: string,
    ): Promise<{ reply: string; sessionId: string }> {
        const res = await fetch(`${BASE_URL}/api/chat`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ message, sessionId }),
        });
        if (!res.ok) throw new Error(`API error: ${res.status}`);
        const data = await res.json();
        if (data.sessionId && data.sessionId !== sessionId) {
            sessionId = data.sessionId;
            localStorage.setItem("chat-session-id", sessionId!);
        }
        return data;
    }

    // --- DOM ---
    const chatLog = document.getElementById("chat-log") as HTMLDivElement;
    const chatInput = document.getElementById("chat-input") as HTMLInputElement;

    // --- Welcome message ---
    // --- Welcome + restore ---
    (function init() {
        const el = document.createElement("div");
        el.className = "chat-welcome";
        el.innerHTML = `<span class="accent">honjoh.ai</span> — Honjoh Nobuhiro の AI です。お気軽にどうぞ。`;
        chatLog.appendChild(el);

        // Restore saved messages
        const saved = loadHistory();
        if (saved.length > 0) {
            saved.forEach((m) => {
                const msg = document.createElement("div");
                msg.className = `chat-entry chat-entry-${m.role}`;
                msg.textContent = m.text;
                chatLog.appendChild(msg);
                conversationHistory.push(m);
            });
            chatLog.scrollTop = chatLog.scrollHeight;
        }
    })();

    // --- Message rendering (A3: color contrast only) ---
    function addEntry(text: string, type: "user" | "ai") {
        const el = document.createElement("div");
        el.className = `chat-entry chat-entry-${type}`;
        el.textContent = text;
        chatLog.appendChild(el);
        chatLog.scrollTop = chatLog.scrollHeight;
        conversationHistory.push({ role: type, text });
        saveHistory();
    }

    function addSystem(text: string): HTMLDivElement {
        const el = document.createElement("div");
        el.className = "chat-entry chat-entry-system";
        el.textContent = text;
        chatLog.appendChild(el);
        chatLog.scrollTop = chatLog.scrollHeight;
        return el;
    }

    function showTyping(): HTMLDivElement {
        const el = document.createElement("div");
        el.className = "chat-entry chat-entry-ai";
        el.id = "typing-msg";
        el.innerHTML =
            '<span class="typing-indicator"><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>';
        chatLog.appendChild(el);
        chatLog.scrollTop = chatLog.scrollHeight;
        return el;
    }

    // --- /send command ---
    function handleSendCommand() {
        if (conversationHistory.length === 0) {
            addSystem("送信する会話がありません。");
            return;
        }

        const summary = conversationHistory
            .map((m) => `${m.role === "user" ? "you" : "ai"}: ${m.text}`)
            .join("\n");

        addSystem(`送信内容 (${conversationHistory.length} messages):`);
        const confirmEl = addSystem("[y] 送信する  [n] キャンセル");

        function handleConfirm(e: KeyboardEvent) {
            if (e.key === "y" || e.key === "Y") {
                document.removeEventListener("keydown", handleConfirm);
                confirmEl.remove();
                doSend();
            } else if (e.key === "n" || e.key === "N" || e.key === "Escape") {
                document.removeEventListener("keydown", handleConfirm);
                confirmEl.remove();
                addSystem("キャンセルしました。");
                chatInput.focus();
            }
        }

        async function doSend() {
            const sending = addSystem("送信中...");
            try {
                const res = await fetch(`${BASE_URL}/api/notify`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ messages: conversationHistory }),
                });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                sending.remove();
                addSystem("送信しました。");
            } catch (err) {
                sending.remove();
                addSystem("送信に失敗しました。");
                console.error("[notify] error:", err);
            }
            chatInput.focus();
        }

        document.addEventListener("keydown", handleConfirm);
    }

    // --- Command palette ---
    const COMMANDS = [
        { name: "/send", desc: "管理者にチャット内容を送信" },
        { name: "/clear", desc: "チャット履歴をクリア" },
    ];

    const cmdPalette = document.getElementById("cmd-palette") as HTMLDivElement;
    let cmdActiveIdx = 0;
    let cmdFiltered: typeof COMMANDS = [];

    function renderPalette(filter: string) {
        cmdFiltered = COMMANDS.filter((c) =>
            c.name.startsWith(filter.toLowerCase()),
        );
        if (cmdFiltered.length === 0) {
            cmdPalette.style.display = "none";
            return;
        }
        cmdActiveIdx = 0;
        const header = `<div class="cmd-header">commands</div>`;
        const items = cmdFiltered
            .map((c, i) => {
                const matchLen = filter.length;
                const matched = c.name.slice(0, matchLen);
                const rest = c.name.slice(matchLen);
                const nameHtml = `<span class="cmd-match">${matched}</span>${rest}`;
                return `<div class="cmd-item${i === 0 ? " cmd-active" : ""}" data-idx="${i}"><span class="cmd-name">${nameHtml}</span><span class="cmd-desc">${c.desc}</span></div>`;
            })
            .join("");
        cmdPalette.innerHTML = `${header}${items}`;
        cmdPalette.style.display = "block";

        cmdPalette.querySelectorAll(".cmd-item").forEach((el) => {
            el.addEventListener("click", () => {
                const idx = Number((el as HTMLElement).dataset.idx);
                selectCommand(idx);
            });
        });
    }

    function hidePalette() {
        cmdPalette.style.display = "none";
        cmdFiltered = [];
    }

    function updateActiveItem() {
        cmdPalette.querySelectorAll(".cmd-item").forEach((el, i) => {
            el.classList.toggle("cmd-active", i === cmdActiveIdx);
        });
    }

    function selectCommand(idx: number) {
        const cmd = cmdFiltered[idx];
        if (!cmd) return;
        chatInput.value = "";
        hidePalette();
        executeCommand(cmd.name);
    }

    function executeCommand(name: string) {
        switch (name) {
            case "/send":
                handleSendCommand();
                break;
            case "/clear":
                clearHistory();
                chatLog.innerHTML = "";
                const el = document.createElement("div");
                el.className = "chat-welcome";
                el.innerHTML = `<span class="accent">honjoh.ai</span> — Honjoh Nobuhiro の AI です。お気軽にどうぞ。`;
                chatLog.appendChild(el);
                addSystem("チャット履歴をクリアしました。");
                break;
        }
    }

    // --- Send message ---
    let isProcessing = false;

    async function sendMessage() {
        const text = chatInput.value.trim();
        if (!text || isProcessing) return;
        chatInput.value = "";
        hidePalette();

        const matchedCmd = COMMANDS.find((c) => c.name === text);
        if (matchedCmd) {
            executeCommand(matchedCmd.name);
            return;
        }

        isProcessing = true;
        addEntry(text, "user");
        const typingMsg = showTyping();

        try {
            const data = await callChatAPI(text);
            typingMsg.remove();
            addEntry(data.reply, "ai");
        } catch (err) {
            typingMsg.remove();
            addEntry(getMockResponse(), "ai");
            console.error("[chat] API error:", err);
        }

        isProcessing = false;
        chatInput.focus();
    }

    // --- Event listeners ---
    chatInput.addEventListener("input", () => {
        const val = chatInput.value;
        if (val.startsWith("/") && val.length >= 1) {
            renderPalette(val);
        } else {
            hidePalette();
        }
    });

    chatInput.addEventListener("keydown", (e: KeyboardEvent) => {
        if (cmdPalette.style.display !== "none" && cmdFiltered.length > 0) {
            if (e.key === "ArrowUp") {
                e.preventDefault();
                cmdActiveIdx =
                    (cmdActiveIdx - 1 + cmdFiltered.length) %
                    cmdFiltered.length;
                updateActiveItem();
                return;
            }
            if (e.key === "ArrowDown") {
                e.preventDefault();
                cmdActiveIdx = (cmdActiveIdx + 1) % cmdFiltered.length;
                updateActiveItem();
                return;
            }
            if (e.key === "Enter") {
                e.preventDefault();
                selectCommand(cmdActiveIdx);
                return;
            }
            if (e.key === "Escape") {
                e.preventDefault();
                hidePalette();
                return;
            }
        }

        if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });

    document.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.ctrlKey || e.altKey || e.metaKey) return;

        if (e.key === "/" && document.activeElement !== chatInput) {
            e.preventDefault();
            chatInput.focus();
            chatInput.value = "/";
            chatInput.dispatchEvent(new Event("input"));
            return;
        }

        if (e.key === "ArrowLeft" || e.key === "Escape") {
            if (
                chatInput.value.trim() === "" &&
                cmdPalette.style.display === "none"
            ) {
                e.preventDefault();
                window.location.href = "/";
            }
        }
    });

    // Check for initial query from top page prompt
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get("q");
    if (initialQuery) {
        window.history.replaceState({}, "", "/chat");
        chatInput.value = initialQuery;
        sendMessage();
    } else {
        chatInput.focus();
    }
</script>
