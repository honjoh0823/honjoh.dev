---
import TerminalLayout from "../layouts/TerminalLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";

const navItems = [
	{
		key: "1",
		label: "works",
		href: "/works",
		desc: "projects",
		disabled: false,
	},
	{
		key: "2",
		label: "article",
		href: "/article",
		desc: "writing",
		disabled: false,
	},
	{ key: "3", label: "about", href: "#", desc: "profile", disabled: true },
	{
		key: "4",
		label: "chat",
		href: "#",
		desc: "ai agent",
		disabled: true,
	},
	{
		key: "5",
		label: "setting",
		href: "/setting",
		desc: "config",
		disabled: false,
	},
];
---

<TerminalLayout
	title="honjoh.dev"
	description="Honjoh Nobuhiro - Personal Site"
>
	<header class="page-header" slot="header">
		<div class="header-top">
			<span class="site-name">honjoh.dev</span>
			<span class="tagline"><span class="status-dot" aria-hidden="true"></span>Online</span>
		</div>
		<div class="subtitle">Nobuhiro Honjoh</div>
	</header>

	<div class="page-body">
		<nav class="nav-menu" id="menu" aria-label="Main navigation">
			{
				navItems.map((item, idx) => (
					<a
						class={`nav-item${item.disabled ? " nav-disabled" : ""}`}
						href={item.href}
						data-desc={item.desc}
						data-idx={idx}
						data-key={item.key}
						data-disabled={item.disabled ? "true" : undefined}
						id={`nav-${idx}`}
					>
						<span class="nav-key">{item.key}</span>
						<span class="nav-label">{item.label}</span>
						<span class="nav-desc">{item.desc}</span>
					</a>
				))
			}
		</nav>
	</div>

	<SiteFooter slot="footer">
		<span><kbd>↑</kbd><kbd>↓</kbd><kbd>→</kbd> 移動</span>
		<span><kbd>enter</kbd> open</span>
	</SiteFooter>
</TerminalLayout>

<style>
	/* Top page header — inline since only used here */
	.page-header {
		position: relative;
		z-index: 1;
	}

	.header-top {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 1rem;
	}

	.site-name {
		font-weight: 700;
		font-size: 1.1rem;
		letter-spacing: 0.12em;
		color: var(--fg-bright);
	}

	.tagline {
		color: var(--dim);
		font-size: 0.8rem;
		font-weight: 300;
		display: inline-flex;
		align-items: center;
		gap: 0.5ch;
	}

	.status-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #39c26a;
		box-shadow: 0 0 0 1px color-mix(in srgb, #39c26a 45%, transparent);
	}

	.subtitle {
		font-size: 0.8rem;
		color: var(--dim);
		margin-bottom: 2rem;
	}

	.page-body .nav-item {
		border-left: none;
	}

	.page-body .nav-item:hover,
	.page-body .nav-item.nav-active {
		border-left-color: transparent;
	}
</style>

<script>
	const items = document.querySelectorAll<HTMLAnchorElement>(".nav-item");
	let idx = 0;

	function update(i: number) {
		items.forEach((el) => el.classList.remove("nav-active"));
		items[i].classList.add("nav-active");
		idx = i;
	}

	function navigate() {
		const item = items[idx] as HTMLElement;
		if (item.dataset.disabled === "true") return;
		const href = item.getAttribute("href");
		if (href && href !== "#") {
			window.location.href = href;
		}
	}

	document.addEventListener("keydown", (e: KeyboardEvent) => {
		if (e.ctrlKey || e.altKey || e.metaKey) return;

		switch (e.key) {
			case "ArrowDown":
			case "j":
				e.preventDefault();
				update(idx < items.length - 1 ? idx + 1 : 0);
				break;
			case "ArrowUp":
			case "k":
				e.preventDefault();
				update(idx > 0 ? idx - 1 : items.length - 1);
				break;
			case "ArrowRight":
			case "Enter":
				e.preventDefault();
				navigate();
				break;
			default:
				const num = parseInt(e.key);
				if (num >= 1 && num <= items.length) {
					e.preventDefault();
					update(num - 1);
					navigate();
				}
				break;
		}
	});

	items.forEach((item, i) => {
		item.addEventListener("mouseenter", () => update(i));
		item.addEventListener("click", () => navigate());
	});

	// Highlight first item on load
	update(0);
</script>
