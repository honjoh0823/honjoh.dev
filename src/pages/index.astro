---
import TerminalLayout from "../layouts/TerminalLayout.astro";
import ChatInline from "../components/ChatInline.astro";

const navItems = [
	{
		key: "1",
		label: "works",
		href: "/works",
		desc: "projects",
		disabled: false,
	},
	{
		key: "2",
		label: "article",
		href: "/article",
		desc: "writing",
		disabled: false,
	},
	{ key: "3", label: "about", href: "#", desc: "profile", disabled: true },
	{
		key: "4",
		label: "chat",
		href: "/chat",
		desc: "ai agent",
		disabled: false,
	},
	{
		key: "5",
		label: "setting",
		href: "/setting",
		desc: "config",
		disabled: false,
	},
];
---

<TerminalLayout
	title="honjoh.dev"
	description="Honjoh Nobuhiro - Personal Site"
>
	<header class="page-header" slot="header">
		<div class="header-top">
			<span class="site-name">honjoh.dev</span>
			<span class="tagline">Honjoh Nobuhiro</span>
		</div>
		<div class="subtitle">Nobuhiro Honjoh</div>
	</header>

	<div class="page-body">
		<nav class="nav-menu" id="menu" aria-label="Main navigation">
			{
				navItems.map((item, idx) => (
					<a
						class={`nav-item${item.disabled ? " nav-disabled" : ""}`}
						href={item.href}
						data-desc={item.desc}
						data-idx={idx}
						data-key={item.key}
						data-disabled={item.disabled ? "true" : undefined}
						id={`nav-${idx}`}
					>
						<span class="nav-key">{item.key}</span>
						<span class="nav-label">{item.label}</span>
						<span class="nav-desc">{item.desc}</span>
					</a>
				))
			}
		</nav>
		<div class="nav-preview" id="preview">projects</div>
	</div>

	<div slot="footer">
		<ChatInline />

		<div class="hint-bar">
			<span><kbd>↑</kbd><kbd>↓</kbd> move</span>
			<span><kbd>→</kbd> open</span>
			<span><kbd>1</kbd>-<kbd>5</kbd> jump</span>
			<span><kbd>enter</kbd> chat</span>
		</div>
	</div>
</TerminalLayout>

<style>
	/* Top page header — inline since only used here */
	.page-header {
		position: relative;
		z-index: 1;
	}

	.header-top {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 1rem;
	}

	.site-name {
		font-weight: 700;
		font-size: 1.1rem;
		letter-spacing: 0.12em;
		color: var(--fg-bright);
	}

	.tagline {
		color: var(--dim);
		font-size: 0.8rem;
		font-weight: 300;
	}

	.subtitle {
		font-size: 0.8rem;
		color: var(--dim);
		margin-bottom: 2rem;
	}

	/* Hint bar — inherits from HintBar pattern but inline here */
	.hint-bar {
		display: flex;
		align-items: center;
		gap: 2ch;
		font-size: 0.7rem;
		color: var(--dim-deep);
		position: relative;
		z-index: 1;
		margin-top: 0.6rem;
		user-select: none;
	}
</style>

<script>
	const items = document.querySelectorAll<HTMLAnchorElement>(".nav-item");
	const preview = document.getElementById("preview");
	const chatInput = document.getElementById(
		"chat-inline-input",
	) as HTMLInputElement;
	let idx = 0;
	let inMenuMode = false; // Track if we're in menu navigation mode

	function update(i: number) {
		items.forEach((el) => el.classList.remove("nav-active"));
		items[i].classList.add("nav-active");
		if (preview) {
			preview.textContent = (items[i] as HTMLElement).dataset.desc || "";
		}
		idx = i;
	}

	function navigate() {
		const item = items[idx] as HTMLElement;
		if (item.dataset.disabled === "true") return;
		const href = item.getAttribute("href");
		if (href && href !== "#") {
			window.location.href = href;
		}
	}

	function enterMenuMode() {
		inMenuMode = true;
		update(0); // Start at first item
		if (chatInput) chatInput.blur();
	}

	function exitMenuMode() {
		inMenuMode = false;
		items.forEach((el) => el.classList.remove("nav-active"));
		if (chatInput) chatInput.focus();
	}

	document.addEventListener("keydown", (e: KeyboardEvent) => {
		// Chat input is focused
		if (document.activeElement === chatInput) {
			if (e.key === "ArrowDown") {
				e.preventDefault();
				enterMenuMode();
				return;
			}
			if (e.key === "ArrowUp") {
				e.preventDefault();
				inMenuMode = true;
				update(items.length - 1); // Start at last item
				if (chatInput) chatInput.blur();
				return;
			}
			// Other keys handled by chat input
			return;
		}

		// Menu mode navigation
		if (inMenuMode) {
			if (e.ctrlKey || e.altKey || e.metaKey) return;

			switch (e.key) {
				case "ArrowDown":
				case "j":
					e.preventDefault();
					if (idx === items.length - 1) {
						// At last item, go back to chat
						exitMenuMode();
					} else {
						update(idx + 1);
					}
					break;
				case "ArrowUp":
				case "k":
					e.preventDefault();
					if (idx === 0) {
						// At first item, go back to chat
						exitMenuMode();
					} else {
						update(idx - 1);
					}
					break;
				case "ArrowRight":
				case "Enter":
					e.preventDefault();
					navigate();
					break;
				case "Escape":
					e.preventDefault();
					exitMenuMode();
					break;
				case "/":
					e.preventDefault();
					exitMenuMode();
					break;
				default:
					const num = parseInt(e.key);
					if (num >= 1 && num <= items.length) {
						e.preventDefault();
						update(num - 1);
						navigate();
					}
					break;
			}
			return;
		}

		// Global shortcuts (not in menu mode, not in chat)
		if (e.ctrlKey || e.altKey || e.metaKey) return;

		switch (e.key) {
			case "ArrowDown":
				e.preventDefault();
				enterMenuMode();
				break;
			case "/":
				e.preventDefault();
				exitMenuMode();
				break;
			default:
				const num = parseInt(e.key);
				if (num >= 1 && num <= items.length) {
					e.preventDefault();
					enterMenuMode();
					update(num - 1);
					navigate();
				}
				break;
		}
	});

	items.forEach((item, i) => {
		item.addEventListener("mouseenter", () => {
			if (!inMenuMode) {
				enterMenuMode();
			}
			update(i);
		});
		item.addEventListener("click", () => navigate());
	});

	// Initial focus on chat input
	if (chatInput) {
		chatInput.focus();
	}
</script>
