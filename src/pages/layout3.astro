---
import Layout from "../layouts/Layout.astro";
---

<Layout title="layout3 redirect | honjoh.dev" description="layout3 redirect page">
  <main class="layout3-redirect">
    <p>Redirecting to <code>/works/layout3</code>...</p>
    <a href="/works/layout3">Open layout3</a>
  </main>
</Layout>

<script>
  window.location.replace("/works/layout3");
</script>

<style>
  .layout3-redirect {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    gap: 8px;
    font-family: "JetBrains Mono", monospace;
  }
</style>
