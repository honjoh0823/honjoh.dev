---
import TerminalLayout from "../../layouts/TerminalLayout.astro";
import Header from "../../components/Header.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const workItems = [
    {
        key: "1",
        label: "yamato-layout",
        href: "/yamato",
        desc: "大和配列 — キーボード配列",
    },
    { key: "2", label: "manga", href: "#", desc: "漫画 — 準備中" },
    { key: "3", label: "game", href: "#", desc: "ゲーム — 準備中" },
];
---

<TerminalLayout
    title="works | honjoh.dev"
    description="Honjoh Nobuhiro の制作物"
>
    <Header slot="header" path={["works"]} />

    <div class="page-body">
        <nav class="nav-menu" id="nav-menu" aria-label="Works navigation">
            {
                workItems.map((item, idx) => (
                    <a
                        class={`nav-item ${idx === 0 ? "nav-active" : ""}`}
                        href={item.href}
                        data-idx={idx}
                        data-key={item.key}
                        id={`nav-${idx}`}
                    >
                        <span class="nav-key">{item.key}</span>
                        <span class="nav-label">{item.label}</span>
                        <span class="nav-desc">{item.desc}</span>
                    </a>
                ))
            }
        </nav>
        <div class="nav-preview" id="preview">大和配列 — キーボード配列</div>
    </div>

    <SiteFooter slot="footer">
        <span><kbd>←</kbd> back</span>
        <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
        <span><kbd>→</kbd> open</span>
        <span><kbd>1</kbd>-<kbd>3</kbd> jump</span>
    </SiteFooter>
</TerminalLayout>

<style>
    .nav-label {
        min-width: 10em;
    }
</style>

<script>
    const navItems = document.querySelectorAll<HTMLAnchorElement>(".nav-item");
    let activeIdx = 0;

    function setActive(idx: number) {
        if (idx < 0 || idx >= navItems.length) return;
        navItems[activeIdx].classList.remove("nav-active");
        activeIdx = idx;
        navItems[activeIdx].classList.add("nav-active");
        navItems[activeIdx].focus({ preventScroll: true });

        const preview = document.getElementById("preview");
        if (preview) {
            const desc = navItems[activeIdx].querySelector(".nav-desc");
            preview.textContent = desc?.textContent || "";
        }
    }

    function navigate() {
        const href = navItems[activeIdx].getAttribute("href");
        if (href && href !== "#") {
            window.location.href = href;
        }
    }

    document.addEventListener("keydown", (e: KeyboardEvent) => {
        const tag = (e.target as HTMLElement).tagName;
        if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
        if (e.ctrlKey || e.altKey || e.metaKey) return;

        switch (e.key) {
            case "ArrowDown":
            case "j":
                e.preventDefault();
                setActive(activeIdx < navItems.length - 1 ? activeIdx + 1 : 0);
                break;
            case "ArrowUp":
            case "k":
                e.preventDefault();
                setActive(activeIdx > 0 ? activeIdx - 1 : navItems.length - 1);
                break;
            case "ArrowRight":
            case "Enter":
            case " ":
                e.preventDefault();
                navigate();
                break;
            case "ArrowLeft":
                e.preventDefault();
                window.location.href = "/";
                break;
            default:
                const num = parseInt(e.key);
                if (num >= 1 && num <= navItems.length) {
                    e.preventDefault();
                    setActive(num - 1);
                    navigate();
                }
                break;
        }
    });

    navItems.forEach((item, idx) => {
        item.addEventListener("mouseenter", () => {
            navItems[activeIdx].classList.remove("nav-active");
            activeIdx = idx;
            item.classList.add("nav-active");

            const preview = document.getElementById("preview");
            if (preview) {
                const desc = item.querySelector(".nav-desc");
                preview.textContent = desc?.textContent || "";
            }
        });
    });
</script>
